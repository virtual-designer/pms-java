<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.DatePicker?>
<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.nsu.cse215.labgroup3.pms.controllers.AddController"
    spacing="10"
    stylesheets="@add-view.css"
>
    <fx:include source="../components/back-button.fxml" />

    <VBox
        styleClass="innerRootBox"
    >
        <Label
            text="Add a parcel"
            styleClass="text, topHeading"
        />

        <VBox styleClass="formBox">
            <VBox.margin>
                <Insets top="25" />
            </VBox.margin>

            <VBox>
                <Label text="Tracking ID" styleClass="text, formLabel" />
                <TextField
                    styleClass="text, textField, formTextField"
                    promptText="8-character tracking ID"
                />
            </VBox>

            <VBox>
                <Label text="Description" styleClass="text, formLabel" />
                <TextArea
                    styleClass="text, textField, formTextField"
                    prefRowCount="5"
                    promptText="Enter a description...."
                >
                </TextArea>
                <Text styleClass="text, formHelperText">Descriptions should be easy-to-understand and compact.</Text>
            </VBox>

            <GridPane hgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>

                <VBox GridPane.columnIndex="0">
                    <Label text="Weight" styleClass="text, formLabel" />

                    <StackPane styleClass="textFieldStackPane">
                        <TextField
                            styleClass="text, textField, formTextField"
                            promptText="Parcel weight in grams"
                        />

                        <Label styleClass="text, textFieldEnd">grams</Label>
                    </StackPane>
                </VBox>

                <VBox GridPane.columnIndex="1">
                    <Label text="ETA" styleClass="text, formLabel" />
                    <DatePicker
                        styleClass="text, textField, datePicker"
                        maxWidth="Infinity"
                        promptText="Pick a date..."
                        fx:id="estimatedTimeOfArrival"
                    />
                </VBox>
            </GridPane>
        </VBox>
    </VBox>
</VBox>